{
  "name": "ai-data-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI 对话式数据助手：Vue3 + Node，SSE 流式输出、工具调用可视化、ECharts 结果渲染",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"node server/index.js\" \"vite --config web/vite.config.js\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "echarts": "^5.5.1",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  }
}
